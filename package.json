{
  "name": "@rushdb/mcp-server",
  "description": "RushDB MCP Server - Model Context Protocol server for RushDB",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "rushdb",
    "ai-platform",
    "knowledge-engine",
    "application-platform",
    "llm",
    "ai-agents",
    "ai-memory",
    "tools"
  ],
  "license": "Apache-2.0",
  "version": "3.0.1",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "rushdb-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build:esbuild": "node esbuild.config.js",
    "build": "rimraf build && node esbuild.config.js --prod",
    "watch:esbuild": "node esbuild.config.js --watch",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@rushdb/javascript-sdk": "^3.0.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@hono/node-server": "1.19.13",
    "dotenv": "^16.4.7",
    "hono": "4.12.12",
    "jose": "^5.9.0",
    "jsonschema": "^1.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@modelcontextprotocol/inspector": "^0.17.0",
    "@types/node": "^20.17.23",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.1",
    "typescript": "5.7.2",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {},
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/rush-db/mcp-server/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rush-db/mcp-server.git"
  },
  "homepage": "https://github.com/rush-db/mcp-server#readme",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
